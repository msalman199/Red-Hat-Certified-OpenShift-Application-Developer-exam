Subtask 1.2: Build and Push Container Images
Step 1: Build both images with Podman and log in to the OpenShift internal registry.

cd ~/fullstack-app/backend
podman build -t backend:latest .

cd ~/fullstack-app/frontend
podman build -t frontend:latest .

# Expose the internal registry route for pushing (if not already exposed)
oc get route default-route -n openshift-image-registry 2>/dev/null || \
  oc patch configs.imageregistry.operator.openshift.io/cluster \
    --patch '{"spec":{"defaultRoute":true}}' --type=merge

REGISTRY=$(oc get route default-route -n openshift-image-registry -o jsonpath='{.spec.host}')
echo "Registry: $REGISTRY"

podman login -u $(oc whoami) -p $(oc whoami -t) $REGISTRY --tls-verify=false
Step 2: Tag and push the images into the fullstack-final project's image streams.

podman tag backend:latest $REGISTRY/fullstack-final/backend:latest
podman tag frontend:latest $REGISTRY/fullstack-final/frontend:latest

podman push $REGISTRY/fullstack-final/backend:latest --tls-verify=false
podman push $REGISTRY/fullstack-final/frontend:latest --tls-verify=false

# Confirm the image streams were created
oc get imagestream -n fullstack-final
Deliverable for Subtask 1.2: oc get imagestream -n fullstack-final shows two image streams, backend and frontend, each with at least one tag (latest). This confirms both images were built and pushed successfully.

Task 2: Deploy the Application to OpenShift
Subtask 2.1: Deploy PostgreSQL with Automated Schema Initialization
Step 1: Create the database deployment. To avoid a manual initialization step being forgotten, the schema is created automatically using a PostgreSQL init script mounted via ConfigMap, which the official postgres image executes on first startup.

cd ~/fullstack-app

cat > database-deployment.yaml << 'EOF'
apiVersion: v1
kind: ConfigMap
metadata:
  name: postgres-init-script
data:
  init.sql: |
    CREATE TABLE IF NOT EXISTS users (
      id SERIAL PRIMARY KEY,
      name VARCHAR(255) NOT NULL,
      email VARCHAR(255) NOT NULL
    );
    INSERT INTO users (name, email)
    SELECT 'Ada Lovelace', 'ada@example.com'
    WHERE NOT EXISTS (SELECT 1 FROM users);
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgresql
  labels:
    app: postgresql
spec:
  replicas: 1
  selector:
    matchLabels:
      app: postgresql
  template:
    metadata:
      labels:
        app: postgresql
    spec:
      containers:
      - name: postgresql
        image: postgres:13
        env:
        - name: POSTGRES_DB
          value: "fullstack_db"
        - name: POSTGRES_USER
          value: "postgres"
        - name: POSTGRES_PASSWORD
          value: "password"
        ports:
        - containerPort: 5432
        volumeMounts:
        - name: postgres-storage
          mountPath: /var/lib/postgresql/data
        - name: init-script
          mountPath: /docker-entrypoint-initdb.d
      volumes:
      - name: postgres-storage
        persistentVolumeClaim:
          claimName: postgres-pvc
      - name: init-script
        configMap:
          name: postgres-init-script
---
apiVersion: v1
kind: Service
metadata:
  name: postgresql
spec:
  selector:
    app: postgresql
  ports:
  - port: 5432
    targetPort: 5432
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-pvc
spec:
  accessModes:
  - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
EOF

oc apply -f database-deployment.yaml
oc rollout status deployment/postgresql
Step 2: Verify the schema was created. Because postgres:13 only runs files in /docker-entrypoint-initdb.d on a fresh data volume, confirm the table exists before proceeding. If the PVC was reused from a prior run and the table is missing, create it manually as a fallback.

POSTGRES_POD=$(oc get pods -l app=postgresql -o jsonpath='{.items[0].metadata.name}')

# Verify the table exists
oc exec $POSTGRES_POD -- psql -U postgres -d fullstack_db -c "\dt users"

# Fallback: if the table does not exist, create it manually
oc exec $POSTGRES_POD -- psql -U postgres -d fullstack_db -c \
  "CREATE TABLE IF NOT EXISTS users (id SERIAL PRIMARY KEY, name VARCHAR(255), email VARCHAR(255));"
Deliverable for Subtask 2.1: oc exec $POSTGRES_POD -- psql -U postgres -d fullstack_db -c "\dt users" returns a table listing showing users with schema public. This confirms the database is initialized and ready before the backend attempts any queries against it.

Subtask 2.2: Deploy Backend and Frontend with Networking
Step 1: Deploy the backend, referencing the image stream built earlier.

REGISTRY=$(oc get route default-route -n openshift-image-registry -o jsonpath='{.spec.host}')

cat > backend-deployment.yaml << EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend
  labels:
    app: backend
spec:
  replicas: 2
  selector:
    matchLabels:
      app: backend
  template:
    metadata:
      labels:
        app: backend
    spec:
      containers:
      - name: backend
        image: image-registry.openshift-image-registry.svc:5000/fullstack-final/backend:latest
        env:
        - name: DB_HOST
          value: "postgresql"
        - name: DB_PORT
          value: "5432"
        - name: DB_NAME
          value: "fullstack_db"
        - name: DB_USER
          value: "postgres"
        - name: DB_PASSWORD
          value: "password"
        - name: PORT
          value: "3000"
        ports:
        - containerPort: 3000
        livenessProbe:
          httpGet:
            path: /health
            port: 3000
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /health
            port: 3000
          initialDelaySeconds: 5
          periodSeconds: 5
        resources:
          requests:
            memory: "128Mi"
            cpu: "100m"
          limits:
            memory: "256Mi"
            cpu: "200m"
---
apiVersion: v1
kind: Service
metadata:
  name: backend-service
spec:
  selector:
    app: backend
  ports:
  - port: 3000
    targetPort: 3000
EOF

oc apply -f backend-deployment.yaml
oc rollout status deployment/backend
Step 2: Deploy the frontend and expose it via a Route.

cat > frontend-deployment.yaml << 'EOF'
apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  labels:
    app: frontend
spec:
